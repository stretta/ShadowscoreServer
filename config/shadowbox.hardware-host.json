{
  "http": {
    "host": "0.0.0.0",
    "port": 8790,
    "publicUrl": "http://shadowbox-host.local:8790"
  },
  "server": {
    "role": "host",
    "advertisedName": "Shadowbox Host",
    "hostIdentity": "shadowbox-host"
  },
  "registration": {
    "enabled": true,
    "sessionHostUrl": "",
    "heartbeatIntervalMs": 10000,
    "heartbeatTtlMs": 30000,
    "discovery": {
      "enabled": true,
      "timeoutMs": 5000,
      "pollIntervalMs": 200,
      "probeTimeoutMs": 1500
    }
  },
  "transport": {
    "tempoAuthority": "link",
    "link": {
      "clientName": "jack-transport-link"
    },
    "jack": {
      "enabled": false,
      "host": "shadowbox-host",
      "freshnessMs": 500,
      "pollIntervalMs": 75
    }
  },
  "static": {
    "enabled": true,
    "root": "public/matrix-edit",
    "index": "index.html"
  },
  "persistence": {
    "enabled": true,
    "path": "data/score.json",
    "backupPath": "data/score.previous.json",
    "debounceMs": 150
  },
  "rnbo": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 1234,
    "address": "/rnbo/inst/2/messages/in/shadowscore",
    "oscQuery": {
      "enabled": true,
      "url": "http://127.0.0.1:5678/",
      "timeoutMs": 1000,
      "addressPattern": "shadowscore"
    },
    "capabilities": {
      "supportsBeginReplaceClear": true,
      "activeRowCountCommit": true,
      "compactScoreReplace": true,
      "stagedScoreActivation": true,
      "maxNoteRows": 819,
      "noteDataFloatCount": 16384
    },
    "stagesPerBeat": 16,
    "clearRowCount": 64,
    "transactionStart": 1000,
    "sendBatchSize": 4,
    "sendDelayMs": 5
  }
}
